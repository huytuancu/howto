# keycloak_realm
is used to generate authentication_token

EXAMPLE:
bash

REALM="http://localhost:8080/realms/myrealm"

RETRY_OPTIONS=(--retry-connrefused --retry 5 --retry-delau 15)

ACCESS_TOKEN=$(curl -s -X POST ${RETRY_OPTIONS[@]} \
  "${REALM}/protocol/openid-connect/token" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "username=${my-user}" \
  -d "password=${my-pass}" \
  -d "grant_type=client_credentials" )

## Collecting basic git commands on Linux based and Windows if you like

# git configuration
.gitconfig # thís file stores important information of user and repo eg: url
.gitmodules # URLs inside


# reset to master branch
git reset --hard origin/master

git add . # add all files updated

# push empty commit
git commit --allow-empty -m "Commit message" # delete --allow-empty if adding files

git pull --rebase
git push origin HEAD:refs/for/master # push to HEAD aka latest on master branch

# useful git config
git config user.name < >
git config user.email < >

git config branch.master.url < >
git config branch.master.pushurl < >

git config remote.origin.url https://<your domain>.com/<...>/
git config remote.origin.pushurl < >

git fetch origin "refs/notes/*:refs/notes/*" # check git notes

# ref info
eg:
refs/users/ references per user
refs/meta/
refs/changes
...

# git for windows eg: win 11
ask chatgpt for command to install
eg:
winget install --id Git.Git -e --source winget

then restart Visual Studio Code again then
git --version

cd "C:\your-project"
git init

git config --global user.name "your name matching on gitlab"
git config --global user.email "your email"

# make your change
git add .
git commit -m "Initial commit"

git branch -M main

git remote add origin https://gitlab.com/username/project.git

git push -u origin main



# important: functional user configured in gitlab MUST have read/write permissions towards Docker Registry

# settings > ci/cd > Runners

# settings > ci/cd > Variables
create global variables for gitlab-ci.yml file

// Key
DOCKER_AUTH_CONFIG

// Value
{
  "auths": {
    "your_registry_without_https": {
      "auth": "user:pass | base64" # --> convert user/pass to base 64 code before copying to
    }
  }
}

# Code > Repository

# Build > Pipelines

# clone & push code from your development server
- get PAT token from gitlab
- update .netrc file
- using git commands


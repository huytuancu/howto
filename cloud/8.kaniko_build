# we can build docker image locally using docker ínstalled on build server eg: Jenkins or local development pc
# however on K8S cluster we may have other alternatives to build docker image
# kaniko is an option to build docker image on K8s cluster
# we need to deploy kaniko application on K8S before usingg it

https://github.com/GoogleContainerTools/kaniko

# Make sure to fid is able to connect Registry Server

# Build
/kaniko/executor \
  --context $(CI_PROJECT_DIR)/build_contect \
  --dockerfile $(CI_PROJECT_DIR)/Dockerfile \
  --destination <your full image name having registry information>:<your image tag> \
  --build-arg arg_=<???>
  ...

# key notes
it is not easy to remember rules in writing typescript, just understand the idea of logic then search AI for faster 

# file name
eg: typescript.ts

# import import standard , plugin , self defined libs etc
eg:

impport { randomBytes } from 'node:crypto';
import { myFunction } from './myLib'; # myLib.ts is introduced

# constant --> define variable

# function --> standard function, is used on current file

# export function --> the function can be exported to be used by other files

# let --> define local variable 
eg:
let stderr = '';

# await --> polling

# .toString('base64') --> convert the string to base64

# expect --> expect return to match
eg:
expect(logs).toContain(' ready ')

# export async function <my function> --> self defined function
# at least need to write unit test for each function/class --> check chatgpt for examples

# async function --> function to processing asynchronous aka can use await inside

# throw new
eg:
throw new InputError('user passing wrong variable');

# interface --> an object in typescript
eg:
interface User {
  id: number;
  name: string;
  email: string;
}

then declare:

const user: User = {
  id: 1,
  name: "Max",
  email: "max0987654321@gmail.com"
};

